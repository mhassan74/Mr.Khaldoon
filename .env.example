## Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Root URL the tests run against. playwright.config.ts reads this into `use.baseURL`.
# Mr Khaldoon's routes are locale-prefixed (/en/...) — page objects already build
# paths with the /en prefix, so keep BASE_URL as the bare origin.
BASE_URL=https://mrkhaldoon.com

# Credentials for the account tests/auth.setup.ts logs in with once per run.
# Use a dedicated QA test account, never a real student's credentials.
TEST_USER_EMAIL=student@test.com
TEST_USER_PASSWORD=changeme
