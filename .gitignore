node_modules/

# Editor/IDE
.idea/

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Saved login session — regenerated by the setup project every run
playwright/.auth/

# Secrets
.env

# Lighthouse CI raw per-run output — cleaned up automatically after each
# run by generate-latest-reports.js; these patterns are just a safety net
# in case a run gets interrupted before cleanup. The *-report-latest.html
# files it produces are NOT ignored — tracked like the k6 latest files.
.lighthouseci/
performance/lighthouse/reports/*.report.html
performance/lighthouse/reports/*.report.json
performance/lighthouse/reports/manifest.json

# Personal Claude Code settings (not shared with the team)
.claude/settings.local.json
